{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LocalEDRDetectionRule",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
    "mitre_tactic": { "type": "string" },
    "mitre_technique_id": { "type": "string" },
    "mitre_technique_name": { "type": "string" },
    "mitre_subtechnique_id": { "type": "string" },
    "enabled": { "type": "boolean", "default": true },
    "conditions": { "type": "object" },
    "why_explanation": { "type": "string" }
  },
  "required": ["id", "name", "severity", "mitre_tactic", "mitre_technique_id", "conditions", "why_explanation"]
}
